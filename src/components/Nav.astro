---
import T from './T.astro';
import Icon from './Icon.astro';
import { contact } from '../data/content';

const links = [
  ['#palmares', 'nav.stats'],
  ['#povestea', 'nav.story'],
  ['#discipline', 'nav.disciplines'],
  ['#campion', 'nav.champion'],
  ['#contact', 'nav.contact'],
];
---
<header id="site-header" class="site-header fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-concrete/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-10" aria-label="Principal">
    <a href="#top" class="display metal whitespace-nowrap text-2xl leading-none tracking-wide" aria-label="Robert Turda">Robert Turda</a>

    <ul class="hidden items-center gap-7 lg:flex">
      {links.map(([href, key]) => (
        <li><a class="nav-link" data-spy href={href}><T k={key} /></a></li>
      ))}
    </ul>

    <div class="flex items-center gap-2 sm:gap-4">
      <button type="button" data-lang-toggle data-i18n-label="nav.lang" aria-label="Switch to English"
        class="flex min-h-11 min-w-11 cursor-pointer items-center justify-center gap-1 px-2 text-sm font-bold tracking-[0.12em] transition-colors hover:text-chalk">
        <span data-lang-opt="ro" class="text-chalk">RO</span><span class="text-ash/60" aria-hidden="true">/</span><span data-lang-opt="en" class="text-ash">EN</span>
      </button>
      <a href={contact.phoneHref} class="btn btn-red !min-h-10 !px-3 sm:!px-4 !py-2 !text-sm !tracking-[0.06em]">
        <Icon name="phone" size={16} />
        <span class="sr-only sm:not-sr-only"><T k="nav.call" /></span>
        <span class="hidden md:inline">{contact.phoneDisplay}</span>
      </a>
    </div>
  </nav>
  <div class="scroll-progress" aria-hidden="true"></div>
</header>
