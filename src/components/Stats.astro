---
import T from './T.astro';

// Competition record: the three titles, oldest first so it builds to the 2022 gold.
const titles = ['1', '2', '3'];
---
<section id="palmares" class="relative border-y border-white/5 bg-pit" aria-labelledby="palmares-title">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-10">
    <T as="h2" k="stats.title" id="palmares-title" class="display metal section-title reveal" />
    <ol class="mt-10 grid gap-10 sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-white/10">
      {titles.map((n, i) => (
        <li class="reveal sm:px-8 sm:first:pl-0" style={`--d:${i * 80}ms`}>
          <T as="p" k={`stats.${n}.year`} class="display text-[clamp(3.5rem,7vw,5.5rem)] leading-none text-blood" />
          <T as="h3" k={`stats.${n}.title`} class="mt-3 max-w-[18rem] text-base font-semibold uppercase tracking-[0.08em] text-silver" />
          <T as="p" k={`stats.${n}.place`} class="mt-1 text-sm text-ash" />
        </li>
      ))}
    </ol>
  </div>
</section>
