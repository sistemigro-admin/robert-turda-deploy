---
import T from './T.astro';
import { yearsCoaching } from '../data/content';

const stats = [
  { n: 2, suffix: '×', key: 'stats.1' },
  { n: 1, suffix: '', key: 'stats.2' },
  { n: yearsCoaching, suffix: '+', key: 'stats.3' },
];
---
<section id="palmares" class="relative border-y border-white/5 bg-pit" aria-labelledby="palmares-title">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-10">
    <T as="h2" k="stats.title" id="palmares-title" class="display metal section-title reveal" />
    <dl class="mt-10 grid gap-10 sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-white/10" data-counters>
      {stats.map((s, i) => (
        <div class="reveal flex flex-col-reverse sm:px-8 sm:first:pl-0" style={`--d:${i * 80}ms`}>
          <T as="dt" k={s.key} class="mt-3 max-w-[18rem] text-base font-semibold uppercase tracking-[0.08em] text-silver" />
          <dd class="display text-[clamp(3.5rem,7vw,5.5rem)] leading-none text-blood" data-count={s.n} data-suffix={s.suffix}>{s.n}{s.suffix}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
