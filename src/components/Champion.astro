---
import T from './T.astro';
---
<section id="campion" class="bg-pit" aria-labelledby="campion-title">
  <div class="mx-auto grid max-w-7xl lg:grid-cols-2">
    <!-- Poster panel: replace with the high-res Daniel Rohnean poster when supplied -->
    <div class="poster reveal-scale relative flex min-h-[30rem] flex-col justify-between overflow-hidden p-8 sm:p-12 lg:min-h-[40rem]">
      <span class="display outline-text pointer-events-none absolute -bottom-10 -right-6 select-none text-[clamp(10rem,28vw,20rem)] leading-none" aria-hidden="true">54</span>
      <T as="p" k="champ.poster.label" class="display relative text-[clamp(1.5rem,3vw,2.25rem)] text-blood" />
      <div class="relative">
        <p class="display metal text-[clamp(3.75rem,10vw,7.5rem)] leading-[0.86]">Rohnean<br />Daniel</p>
        <hr class="red-rule mt-7 w-24" />
        <T as="p" k="champ.poster.meta" class="mt-5 text-lg font-semibold uppercase tracking-[0.12em] text-chalk" />
        <T as="p" k="champ.poster.place" class="mt-1 text-lg font-semibold uppercase tracking-[0.12em] text-silver" />
      </div>
    </div>

    <div class="flex flex-col justify-center px-4 py-16 sm:px-12 sm:py-20 lg:px-16">
      <T as="h2" k="champ.title" id="campion-title" class="display metal section-title reveal" />
      <T as="p" k="champ.body" class="reveal mt-7 max-w-[54ch] text-lg leading-relaxed text-chalk/85" />
      <ol class="reveal mt-10 grid gap-4 sm:grid-cols-2">
        <li class="border-t border-white/15 pt-4"><T k="champ.from" class="text-silver" /></li>
        <li class="border-t border-blood pt-4"><T k="champ.to" class="font-semibold text-chalk" /></li>
      </ol>
    </div>
  </div>
</section>
