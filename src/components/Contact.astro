---
import T from './T.astro';
import Icon from './Icon.astro';
import { contact } from '../data/content';
---
<section id="contact" class="relative bg-pit" aria-labelledby="contact-title">
  <hr class="red-rule draw" />
  <div class="mx-auto max-w-5xl px-4 py-24 text-center sm:px-6 sm:py-32">
    <T as="p" k="contact.kicker" class="label reveal !text-blood" />
    <T as="h2" k="contact.headline" id="contact-title"
      class="display metal reveal-zoom mx-auto mt-5 max-w-4xl text-[clamp(2.5rem,6.5vw,5.25rem)] leading-[1.1]" />
    <T as="p" k="contact.sub" class="reveal mx-auto mt-6 max-w-[48ch] text-lg text-silver" />

    <div class="reveal mt-12 flex flex-col items-center gap-5">
      <a href={contact.phoneHref} class="btn btn-red pulse-idle !min-h-14 !px-9 !text-base">
        <Icon name="phone" size={20} />
        <T k="contact.cta" />
      </a>
      <a href={contact.phoneHref} class="phone-big display text-[clamp(2rem,5vw,3rem)] tracking-wide text-chalk">{contact.phoneDisplay}</a>
      <a href={contact.facebook} target="_blank" rel="noopener" class="nav-link !normal-case !tracking-normal !text-base">
        <T k="contact.fb" />
      </a>
    </div>

    <div class="reveal mx-auto mt-14 flex max-w-xl flex-col items-center justify-center gap-3 border-t border-white/10 pt-8 text-silver sm:flex-row sm:gap-8">
      <a href={`mailto:${contact.email}`} class="inline-flex min-h-11 items-center gap-2 transition-colors hover:text-chalk"><Icon name="mail" size={18} />{contact.email}</a>
      <a href={contact.instagram} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 transition-colors hover:text-chalk"><Icon name="instagram" size={18} />@robert_turda</a>
    </div>
  </div>
</section>
